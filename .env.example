# Set this to the production origin before launch so canonical URLs,
# structured data, robots.txt and sitemap.xml use the real domain.
NEXT_PUBLIC_SITE_URL=
# Required for launch. Use a current approved business rate and its review date.
USD_ZAR_RATE=16.75
PRICING_RATE_UPDATED_AT=2026-09-14
# Required for launch: none, inclusive or exclusive. These modes only label the
# displayed price; none of them add, remove or calculate VAT.
#   none       = the business does not charge VAT (a valid final choice, not a placeholder)
#   inclusive  = the displayed figure already includes VAT
#   exclusive  = the displayed figure excludes VAT
VAT_DISPLAY_MODE=
CONTACT_RECIPIENT_EMAIL=
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
ANALYTICS_ID=
# At least one public fallback contact method is required for launch.
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_ADDRESS=
# Launch acknowledgement after business/legal review of /privacy and /terms.
LEGAL_CONTENT_APPROVED=false
